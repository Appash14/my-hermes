# ─────────────────────────────────────────────────────────────
# Hermes — copie ce fichier vers .env et remplis les valeurs.
# .env est gitignoré. Ne commit JAMAIS de vraie clé.
# ─────────────────────────────────────────────────────────────

# --- Domaine & réseau ---------------------------------------
# Le domaine pointé vers le VPS (203.0.113.10). Caddy émettra le
# certificat Let's Encrypt automatiquement pour ce nom.
HERMES_DOMAIN=hermes.exemple.com
# Email pour les notifications d'expiration Let's Encrypt
ACME_EMAIL=toi@exemple.com

# --- Cerveau : OpenRouter -----------------------------------
# UNE clé pour ~400 modèles (Claude, GPT, DeepSeek, Gemini, Llama...).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modèle par défaut au démarrage. Modifiable à chaud depuis l'app —
# ceci n'est que la valeur initiale.
# Version épinglée volontairement : l'alias ~deepseek/deepseek-v4-flash-latest
# bascule tout seul vers la prochaine release, ce qui ferait changer le
# comportement de l'agent sans que tu aies rien modifié.
HERMES_DEFAULT_MODEL=deepseek/deepseek-v4-flash-0731

# Modèle utilisé pour les tâches internes (titres de conversation,
# extraction de mémoire). V4 Flash est déjà assez peu cher pour tout faire.
HERMES_UTILITY_MODEL=deepseek/deepseek-v4-flash-0731

# Envoyés à OpenRouter pour l'attribution dans leurs classements. Facultatif.
OPENROUTER_SITE_URL=https://hermes.exemple.com
OPENROUTER_SITE_NAME=Hermes

# --- Voix : STT (speech-to-text) ----------------------------
# Deepgram : streaming temps réel, ~200ms de latence.
DEEPGRAM_API_KEY=

# --- Voix : TTS (text-to-speech) ----------------------------
# ElevenLabs : la meilleure qualité de voix française.
ELEVENLABS_API_KEY=
# ID de la voix ElevenLabs à utiliser (dashboard > Voices)
ELEVENLABS_VOICE_ID=

# --- Base de données ----------------------------------------
POSTGRES_USER=hermes
POSTGRES_PASSWORD=change-moi-avec-openssl-rand-hex-32
POSTGRES_DB=hermes
# Utilisé par les services (le host `postgres` = nom du service compose)
DATABASE_URL=postgresql://hermes:change-moi-avec-openssl-rand-hex-32@postgres:5432/hermes

REDIS_URL=redis://redis:6379

# --- Auth ---------------------------------------------------
# Secret de signature des sessions : openssl rand -hex 32
AUTH_SECRET=
# Mono-utilisateur pour commencer : ce code débloque l'accès.
# Passe à un vrai système de comptes plus tard.
HERMES_ACCESS_CODE=

# --- Divers -------------------------------------------------
NODE_ENV=production
# URL publique de l'agent, vue depuis le navigateur
NEXT_PUBLIC_AGENT_URL=https://hermes.exemple.com
